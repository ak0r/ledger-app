# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# Python venv for scripts/cas_parser.py (scripts/setup-python.mjs's
# postinstall step creates this — local runtime state, not versioned)
/.venv
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (SQLite is source of truth per docs/06-architecture.md — the file
# itself is local runtime state, not something to version). The whole
# /data directory, not just *.db globs, since it also holds pan.key (the
# local PAN-encryption key, Portfolio Adoption Plan) — real secret
# material that must never be committed.
/data
*.db
*.db-journal
*.db-shm
*.db-wal

# Agent directories
.claude
