// Conceptual schema, kept in sync with the real Drizzle schema at
// src/server/persistence/schema.ts (field-for-field, snake_case per
// ADR-017). Money values are integer minor units. Timestamps/dates are
// ISO 8601 strings (SQLite has no native datetime type here).
//
// Two sibling domains, deliberately delinked (ADR-040): the Ledger tables
// (profiles down through dashboard_panels) and the Portfolio tables
// (instruments down through portfolio_imports) — zero FKs cross from
// Portfolio into accounts/transactions/postings, enforced additionally by
// an ESLint rule at the TypeScript layer (core/portfolio can't import
// core/ledger).
//
// Renamed from the original `members`-only schema by the 2026-08-20 User
// Simplification delta (ADR-029): `members` → `profiles`, plus a new
// AppUser/Session identity layer above it. Extended by the 2026-08-25/26
// Import Framework + Account Resolution deltas (`import_files`,
// `account_identifiers`, `transactions.import_file_id`), the 2026-09-05
// Portfolio Adoption Plan (`profiles.pan_encrypted`/`pan_hash`, every
// Portfolio table), and Stock Tradebook/eCAS/Yahoo work (2026-09-06,
// `instruments.nse_code`/`bse_code`/`amfi_code`, `holdings.source`'s
// `ECAS_PDF` value). Further extended by the 2026-09-06/08 Account Types,
// Money Representation, Rational Pricing, FX & Liability Details delta
// (ADR-047): `accounts.instrument_type` dropped outright, replaced by
// mandatory `account_type`; `postings.debit`/`credit`/`quantity`/`price`
// dropped outright, replaced by exact-rational `units`/`price_num`/
// `price_denom`/`base_amount`; new `currency_rates`, `credit_card_details`,
// `loan_details` tables.

Table app_users {
  id text [pk]
  email text [not null, unique]
  password_hash text [not null]
  is_primary boolean [not null, default: false, note: 'Set once at registration — the first-ever AppUser in this Hosted Instance. Never toggled again.']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table sessions {
  id text [pk]
  app_user_id text [not null]
  created_at datetime [not null]
  expires_at datetime [not null]
}

Table profiles {
  id text [pk]
  name text [not null]
  app_user_id text [unique, note: 'Nullable — a Profile can exist unlinked to any AppUser (created by the Primary User for someone who registers later).']
  primary_currency_id text [note: 'Default Currency for a newly created Account (Currency Catalogue delta) — not retroactive.']
  pan_encrypted text [note: 'AES-256-GCM ciphertext (base64) — Portfolio Adoption Plan. Decrypted only when a CAS import needs it as the PDF password.']
  pan_hash text [note: 'SHA-256 digest for equality/lookup (e.g. matching a re-imported statement) without decrypting.']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table currencies {
  id text [pk]
  profile_id text [not null]
  code text [not null]
  name text [not null]
  symbol text [not null]
  minor_unit_scale integer [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}

// Dated FX reference rates (ADR-047) — no profile_id column; ownership is
// checked at the service layer via currency_id -> currencies.profile_id
// instead (rule #6's guarantee without a redundant column). Lookup rule:
// exact date -> latest before -> 1/1 parity, never a future-dated row.
// Editing/deleting a rate never changes an already-committed Transaction
// (its resolved rate was already copied into the Posting at creation
// time).
Table currency_rates {
  id text [pk]
  currency_id text [not null]
  date datetime [not null]
  rate_num integer [not null, note: 'rate_num > 0']
  rate_denom integer [not null, note: 'rate_denom > 0']
  created_at datetime [not null]
  updated_at datetime [not null]

  Indexes {
    (currency_id, date) [unique]
  }
}

// Shared reference data — NOT Profile-scoped, unlike every other table
// here (except nav_history below). An Instrument ("HDFC Bank the stock")
// is the same catalogue row regardless of which PortfolioAccount
// references it. Reused as-is by the Portfolio domain after the Ledger/
// Portfolio delink (ADR-040) — never linked to a Ledger `accounts` row.
Table instruments {
  id text [pk]
  type text [not null, note: 'MUTUAL_FUND | STOCK | COMMODITY (InstrumentBackedType)']
  name text [not null]
  unit_label text [note: 'Free-text pricing-unit hint for commodities, e.g. "10g" — null for MUTUAL_FUND/STOCK.']
  source text [note: 'Instrument Catalogue ingestion provenance, e.g. "indianapi" — null for a user/import-created row.']
  source_id text [note: 'The (source, source_id) pair is the catalogue upsert-match identity — not a DB unique index (ADR-039).']
  nse_code text [note: 'Set by Stock tradebook import (broker symbol) or demat eCAS import (casparser-backfilled symbol).']
  bse_code text [note: 'Set by demat eCAS import when casparser reports the BSE exchange.']
  isin text
  amfi_code text [note: 'Mutual Fund fallback identity when a CAS statement scheme has no ISIN — also the AMFI bulk NAV feed primary key.']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table accounts {
  id text [pk]
  profile_id text [not null]
  currency_id text [not null]
  name text [not null]
  classification text [not null, note: 'ASSET | LIABILITY | INCOME | EXPENSE | BALANCING']
  account_type text [not null, note: 'Mandatory per Classification (ADR-047): ASSET=CASH|BANK|INVESTMENTS|WALLET|RECEIVABLES, LIABILITY=CREDIT_CARD|LOAN|PAYABLES, INCOME=EARNED|PASSIVE|WINDFALL, EXPENSE=FIXED|VARIABLE|DISCRETIONARY|FINANCIAL, BALANCING=INITIAL. Never MUTUAL_FUND/STOCK/COMMODITY (Ledger/Portfolio delink, ADR-040).']
  instrument_id text [note: 'Inert since ADR-040 — no longer written by any UI. Free-text (ADR-016), unrelated to the `instruments` catalogue or `account_identifiers`.']
  instrument_label text [note: 'Inert since ADR-040 — no longer written.']
  tags text [note: 'JSON array: string[] (flat opaque strings, not key/value)']
  icon text
  is_archived boolean [not null, default: false]
  metadata text
  created_at datetime [not null]
  updated_at datetime [not null]

  Indexes {
    (profile_id, classification, account_type, name) [unique]
  }
}

// Liability Details (ADR-047) — 1:1 with an Account, no derived-balance
// column on either. Outstanding balance always comes from
// getAccountBalances, same as any other Account.
Table credit_card_details {
  id text [pk]
  account_id text [not null, unique]
  credit_limit_minor integer
  statement_end_day integer [note: '1-31']
  due_day integer [note: '1-31']
  network text
  last4 text
  expiration_date datetime
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table loan_details {
  id text [pk]
  account_id text [not null, unique]
  original_amount_minor integer
  disbursed_amount_minor integer
  interest_rate_bps integer [note: 'Integer basis points — never participates in Posting balancing, so no rational-pair storage needed.']
  tenure_months integer
  emi_amount_minor integer
  emi_day integer [note: '1-31']
  start_date datetime
  maturity_date datetime
  created_at datetime [not null]
  updated_at datetime [not null]
}

// Account Resolution delta (2026-08-26) — a child entity, not a JSON/list
// column on `accounts` (explicitly ruled out). One Account can have
// multiple known representations (a full account number plus masked
// variants observed across statements), each independently queryable.
Table account_identifiers {
  id text [pk]
  account_id text [not null]
  identifier text [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}

// Import Framework delta (2026-08-25) — one row per uploaded source file.
// "Import" (the ephemeral, possibly multi-file review workspace) is never
// itself persisted; this is the persisted provenance record. Phase 1 only
// ever writes status "successful" (atomic commit) — "failed" is reserved
// vocabulary, not yet reachable.
Table import_files {
  id text [pk]
  profile_id text [not null]
  filename text [not null]
  source text [not null, note: 'Adapter id, e.g. "hdfc.account.xls" or "generic.any.csv"']
  status text [not null, note: 'successful | failed (only "successful" is ever written today)']
  account_id text [note: 'The resolved source Account this file posted against.']
  new_account_count integer [not null, default: 0]
  inflow_minor integer [not null, default: 0]
  outflow_minor integer [not null, default: 0]
  date_range_start datetime
  date_range_end datetime
  transaction_count integer [not null]
  metadata text
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table transactions {
  id text [pk]
  profile_id text [not null]
  date datetime [not null]
  description text [not null]
  tags text [note: 'JSON array: string[]']
  import_file_id text [note: 'Nullable — permanent provenance for Transactions created by Import; null for manually-created Transactions.']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table recurring_rules {
  id text [pk]
  profile_id text [not null]
  name text [not null]
  from_account_id text [not null]
  to_account_id text [not null]
  amount_minor integer [not null]
  description text [not null]
  frequency text [not null, note: 'DAILY | WEEKLY | MONTHLY | YEARLY']
  interval integer [not null, default: 1]
  by_month_day integer [note: 'MONTHLY/YEARLY only, 1-31, clamped to the target month length']
  by_weekday integer [note: 'WEEKLY only, 0 (Sunday) - 6 (Saturday)']
  start_date datetime [not null]
  end_date datetime [note: 'null = Never']
  created_at datetime [not null]
  updated_at datetime [not null]
}

// Exact-rational money (ADR-047) — replaces the earlier debit/credit-only
// shape outright. `units` is signed (an Asset Account receiving money is
// positive); `price_num`/`price_denom` is the valuation ratio into the
// Profile's Base Currency (always 1/1 when the Account already uses it);
// `base_amount = round_half_even(units * price_num / price_denom)`,
// computed via checked BigInt arithmetic, never a float.
Table postings {
  id text [pk]
  transaction_id text [not null]
  account_id text [not null]
  units integer [not null, note: 'Signed. units != 0.']
  price_num integer [not null, note: 'price_num > 0']
  price_denom integer [not null, note: 'price_denom > 0']
  base_amount integer [not null, note: 'Signed, Base Currency minor units. SUM(base_amount) == 0 per transaction (the double-entry invariant).']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table budgets {
  id text [pk]
  profile_id text [not null]
  name text [not null]
  type text [not null, note: 'ONE_TIME | RECURRING']
  recurrence_unit text [note: 'RECURRING only: DAY | WEEK | MONTH | YEAR']
  recurrence_interval integer [note: 'RECURRING only']
  recurrence_start_date datetime [note: 'RECURRING only']
  recurrence_end_date datetime [note: 'null = Never, mutually exclusive with recurrence_occurrences']
  recurrence_occurrences integer [note: 'null = Never, mutually exclusive with recurrence_end_date']
  explicit_account_ids text [note: 'JSON array: string[] — the live/current scope, editable']
  filter_match text [note: 'ALL | ANY | NONE — the live/current scope, editable']
  filter_conditions text [note: 'JSON array of {id, field, operator, value} — the live/current scope, editable']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table budget_periods {
  id text [pk]
  budget_id text [not null]
  start_date datetime [note: 'null for a ONE_TIME Budget\'s single Period — no transaction date range required']
  end_date datetime [note: 'null for a ONE_TIME Budget\'s single Period']
  scope_snapshot text [not null, note: 'JSON: frozen {explicitAccountIds, filter} at approval time — authoritative for this Period even after the Budget\'s live scope later changes']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table budget_allocations {
  id text [pk]
  budget_period_id text [not null]
  expense_account_id text [not null]
  target_amount_minor integer [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table dashboards {
  id text [pk]
  profile_id text [not null]
  name text [not null]
  is_default boolean [not null, default: true, note: 'Phase 1 is always true — one Dashboard per Profile. No DB-level uniqueness constraint; enforced at the application layer.']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table dashboard_panels {
  id text [pk]
  dashboard_id text [not null]
  key text [not null, note: 'NET_WORTH | ASSETS | LIABILITIES | BALANCES | RECENT_EXPENSES | RECENT_TRANSACTIONS | BUDGETS_NEEDING_REVIEW — resolved against the application-level Panel Registry']
  configuration text [not null, note: 'JSON, shape depends on key — e.g. Balances: {scope, accountIds[]}']
  x integer [not null]
  y integer [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: 'width/height are never stored — always supplied by the Panel Registry, never user-editable'
}

// --- Portfolio domain (ADR-040/041) — zero FKs into accounts/transactions/
// postings above. `instruments`/`nav_history` are shared reference data,
// not Profile-scoped, same reasoning as `instruments` itself predates this
// section.

Table portfolio_accounts {
  id text [pk]
  profile_id text [not null]
  name text [not null, note: 'e.g. "Zerodha", "CAMS Import"']
  type text [not null, note: 'InstrumentBackedType — MUTUAL_FUND | STOCK | COMMODITY']
  provider text [note: 'e.g. "CAMS/KFin", "NSDL/CDSL eCAS"']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table folios {
  id text [pk]
  portfolio_account_id text [not null]
  number text [not null, note: 'Folio number (MF) or demat account number `dp_id-client_id` (eCAS) — user-typed for tradebook import.']
  amc_code text
  created_at datetime [not null]
  updated_at datetime [not null]
}

// units × price == amount is the domain invariant (the single-sided
// equivalent of a Ledger posting's balance check) — DIVIDEND is exempt
// (a cash payout has no unit/price component).
Table investment_transactions {
  id text [pk]
  profile_id text [not null]
  instrument_id text [not null]
  folio_id text
  date datetime [not null]
  type text [not null, note: 'BUY | SELL | DIVIDEND | BONUS | SPLIT | TRANSFER_IN | TRANSFER_OUT']
  units integer [not null, note: 'Quantity scale (6 decimals), domain/quantity.ts — same fixed scale as Ledger posting.quantity.']
  price real [not null]
  amount integer [not null, note: 'Integer minor units of currency_id.']
  currency_id text [not null]
  source text [not null, note: 'MANUAL | CSV_IMPORT | CAS_PDF']
  source_ref text
  narration text
  dedup_key text [note: 'Content hash for idempotent re-import — DB-level partial unique index on (profile_id, dedup_key) WHERE dedup_key IS NOT NULL.']
  created_at datetime [not null]
  updated_at datetime [not null]
}

// An *observed* snapshot only (a CAS/eCAS closing balance, a manual
// entry) — never the live position, which is always netted fresh from
// investment_transactions. Rows are never deduped/upserted: re-importing
// the same statement adds another point-in-time observation.
Table holdings {
  id text [pk]
  profile_id text [not null]
  instrument_id text [not null]
  folio_id text
  as_of_date datetime [not null]
  units integer [not null]
  source text [not null, note: 'MANUAL | CAS_PDF | CSV_IMPORT | ECAS_PDF']
  source_ref text
  created_at datetime [not null]
  updated_at datetime [not null]
}

// NOT Profile-scoped — a NAV/price is a market fact. One row per
// (instrument_id, date), upserted on refresh (DB-level unique index).
Table nav_history {
  id text [pk]
  instrument_id text [not null]
  date datetime [not null]
  nav real [not null]
  source text [note: 'AMFI | NSE | YAHOO | null for a manual entry']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table portfolio_imports {
  id text [pk]
  profile_id text [not null]
  kind text [not null, note: 'CAS | ECAS | CSV | MANUAL']
  status text [not null, note: 'PENDING | SUCCESS | FAILED']
  filename text
  source_ref text
  result text [note: 'JSON — open shape, summary counts specific to the import kind.']
  error text
  started_at datetime
  finished_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]
}

Ref: sessions.app_user_id > app_users.id
Ref: profiles.app_user_id > app_users.id
Ref: profiles.primary_currency_id > currencies.id
Ref: currencies.profile_id > profiles.id
Ref: accounts.profile_id > profiles.id
Ref: accounts.currency_id > currencies.id
Ref: currency_rates.currency_id > currencies.id [delete: cascade]
Ref: credit_card_details.account_id > accounts.id [delete: cascade]
Ref: loan_details.account_id > accounts.id [delete: cascade]
Ref: account_identifiers.account_id > accounts.id
Ref: import_files.profile_id > profiles.id
Ref: import_files.account_id > accounts.id
Ref: transactions.profile_id > profiles.id
Ref: transactions.import_file_id > import_files.id
Ref: recurring_rules.profile_id > profiles.id
Ref: recurring_rules.from_account_id > accounts.id
Ref: recurring_rules.to_account_id > accounts.id
Ref: postings.transaction_id > transactions.id [delete: cascade]
Ref: postings.account_id > accounts.id
Ref: budgets.profile_id > profiles.id
Ref: budget_periods.budget_id > budgets.id
Ref: budget_allocations.budget_period_id > budget_periods.id
Ref: budget_allocations.expense_account_id > accounts.id
Ref: dashboards.profile_id > profiles.id
Ref: dashboard_panels.dashboard_id > dashboards.id
Ref: portfolio_accounts.profile_id > profiles.id
Ref: folios.portfolio_account_id > portfolio_accounts.id
Ref: investment_transactions.profile_id > profiles.id
Ref: investment_transactions.folio_id > folios.id
Ref: investment_transactions.currency_id > currencies.id
Ref: holdings.profile_id > profiles.id
Ref: holdings.folio_id > folios.id
Ref: portfolio_imports.profile_id > profiles.id

// Domain constraints not fully expressible in this conceptual DBML:
//
// 1. Transaction must have >= 2 postings.
// 2. posting.units != 0; posting.price_num > 0; posting.price_denom > 0.
// 3. posting.base_amount == round_half_even(units * price_num /
//    price_denom) — never independently entered (ADR-047).
// 4. SUM(base_amount) == 0 per transaction (the double-entry invariant;
//    replaces the old SUM(debit) == SUM(credit), ADR-047).
// 5. posting.account.profile_id == transaction.profile_id.
// 6. Any posting whose account currency differs from the profile's Base
//    Currency (profiles.primary_currency_id) prices into it via
//    price_num/price_denom — genuine N-leg cross-currency is valid,
//    MIXED_CURRENCY_UNSUPPORTED is retired (ADR-047). Still no FX
//    aggregation beyond that; a non-reconciling entry is UNBALANCED.
// 7. Hard delete transaction aggregate atomically.
// 8. An AppUser links to at most one Profile (unique); a Profile links to
//    at most one AppUser (nullable) but can exist unlinked.
// 9. An Account can have 0..N AccountIdentifiers; the same identifier must
//    not resolve to more than one Account within a Profile (enforced at
//    the application layer, not a DB constraint).
// 10. import_files.account_id/new_account_count/inflow_minor/outflow_minor
//     are always set for rows created by the current commit path; they
//     predate the Account Resolution delta only in already-migrated rows.
// 11. budget_allocations.expense_account_id must reference an Account with
//     classification EXPENSE, owned by the same Profile as the parent
//     Budget (via budget_period -> budget -> profile).
// 12. budgets.explicit_account_ids entries must likewise be EXPENSE
//     Accounts owned by the same Profile.
// 13. Budget actuals are never persisted — always summed at read time from
//     postings, scoped by the relevant budget_period's own scope_snapshot.
// 14. budget_periods/budget_allocations are never deleted individually —
//     only cascaded (manually, in application code) when the parent Budget
//     itself is deleted; otherwise Periods accumulate as permanent history.
// 15. dashboard_panels.key must be a key the application-level Panel
//     Registry recognizes; configuration shape must match that key's own
//     schema (enforced at the application layer, not a DB constraint).
// 16. A Balances dashboard_panel's configuration.accountIds entries must
//     reference Accounts owned by the same Profile as the parent
//     Dashboard (via dashboard_panel -> dashboard -> profile) — any
//     classification, not Expense-only (unlike Budget scope).
// 17. Every new Profile receives exactly one dashboards row (is_default =
//     true) at creation time; predates-this-delta Profiles receive one
//     lazily, the first time their default Dashboard is read.
// 18. investment_transactions: units * price == amount (DIVIDEND exempt —
//     a cash payout has no unit/price component). instrument_id has no DB
//     FK (instruments isn't Profile-scoped and predates this constraint
//     style, ADR-038's own reasoning) but must reference a real row.
// 19. holdings rows are never deduped/upserted — each import records
//     another point-in-time observation; the live position is always
//     netUnitsFromTransactions() over investment_transactions, never read
//     from holdings.
// 20. Zero FKs cross from any Portfolio table (instruments down through
//     portfolio_imports) into accounts/transactions/postings — enforced
//     additionally by an ESLint rule banning core/portfolio from
//     importing core/ledger (ADR-040).
// 21. A demat eCAS import's PortfolioAccount/Folio auto-resolve from the
//     file's own dp_id/client_id; a Stock tradebook import's instead
//     requires the user to pick or create one first — the two have no
//     automatic way to agree on one Folio identity for the same real
//     demat account (ADR-045).
