[{"id":"IJV8_lwlLeo_EGh-ycz0H","fileId":"bXLD4_5On6DoahSdcQguz","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":26,"lines":["+// Advance Tax Calculator","+// https://finbodhi.com/docs/blog/calculating-advance-tax","+","+# Financial Year","+fy = {date >= [2025-04-01] AND date <= [2026-03-31]}","+","+# Tax Rate","+tax_rate = 30%","+","+# Taxable Income (non-salary)","+fd_interest = balance({account = \"FD\"}) * 7%","+savings_interest = cost({account = \"SBI Interest\" AND fy}) * -1","+taxable_income = fd_interest + savings_interest","+","+# Total Tax","+total_tax = taxable_income * tax_rate","+","+# Advance Tax Payments","+advance_tax = {account = \"Tax\" AND description =~ /Advance Tax/ AND fy}","+tax_paid = cost(advance_tax)","+","+# Installment Schedule","+payable_by_jun15 = total_tax * 15% - cost({advance_tax AND date <= [2025-06-15]})","+payable_by_sep15 = total_tax * 45% - cost({advance_tax AND date <= [2025-09-15]})","+payable_by_dec15 = total_tax * 75% - cost({advance_tax AND date <= [2025-12-15]})","+payable_by_mar15 = total_tax - cost({advance_tax AND date <= [2026-03-15]})"]}],"parentId":null,"profileId":"VPBFIRRM6tmnblXpm8d4u","createdAt":"2026-08-15T17:20:30.429Z","updatedAt":"2026-08-15T17:20:30.429Z","isDeleted":null}]